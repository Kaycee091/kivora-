# Kivora Flutter App Environment Variables
# Copy to .env or pass directly via --dart-define / --dart-define-from-file

APP_MODE=live
SUPABASE_URL=https://bbgecpfqfoqlmzzbfeyu.supabase.co
# Either SUPABASE_ANON_KEY or SUPABASE_PUBLISHABLE_KEY is accepted:
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key


# Kivora web server that sends verification email via Brevo (web/admin)
KIVORA_API_URL=http://localhost:3000
