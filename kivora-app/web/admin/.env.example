# Kivora web admin + email API. Copy to .env.local (local) or add to your host's
# environment variables (Vercel/Netlify/Render...). See docs/email-brevo-setup.md.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://bbgecpfqfoqlmzzbfeyu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
# Server-only. Needed to create accounts and confirm emails. Never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_secret_key

# Brevo SMTP (Brevo -> SMTP & API -> SMTP tab)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_login@smtp-brevo.com
BREVO_SMTP_KEY=xsmtpsib-your_brevo_smtp_key
EMAIL_FROM_ADDRESS=notifications@your-verified-domain.com
EMAIL_FROM_NAME=Kivora

# Optional (defaults to SUPABASE_SERVICE_ROLE_KEY)
EMAIL_OTP_SECRET=

# Origins allowed to call /api/auth/* (the Flutter web app URL; comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5000
