# ==========================================
# KIVORA ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# ------------------------------------------
# Client-Side Variables (Web Admin & Mobile)
# ------------------------------------------
# Public URL of the Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public anonymous key for client requests (enforces Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Mobile build configuration (passed via dart-define)
# FLUTTER_APP_SUPABASE_URL=https://your-project.supabase.co
# FLUTTER_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------
# Server-Side Variables (Edge Functions / Admin Scripts)
# NEVER commit or expose to client bundles!
# ------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_DB_PASSWORD=your_secure_db_password

# ------------------------------------------
# Optional External Services
# ------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_api_key
SMTP_SENDER="Kivora Notifications <notifications@kivora.org>"
