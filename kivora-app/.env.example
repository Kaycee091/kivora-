# ============================================================================
# KIVORA MONOREPO ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================================
# Copy this file to .env.local for Next.js web admin, and use the variables
# below for local development, edge functions, and mobile builds.
# NEVER commit files containing real keys or secrets to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Web Admin Client-Side Variables (Next.js public variables)
# ----------------------------------------------------------------------------
# The root URL of your Supabase project (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# The public anonymous client API key (safe for browser & mobile apps; enforces RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----------------------------------------------------------------------------
# 2. Mobile App (Flutter) Environment Variables
# ----------------------------------------------------------------------------
# Pass these into your flutter run/build command via --dart-define:
# flutter run --dart-define=SUPABASE_URL=https://your-project-id.supabase.co --dart-define=SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----------------------------------------------------------------------------
# 3. Server-Side & Supabase CLI Variables
# ----------------------------------------------------------------------------
# Elevated service role secret (Bypasses RLS - ONLY for server/admin scripts & Edge Functions)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database direct connection password for migrations and local CLI linking
SUPABASE_DB_PASSWORD=your_secure_db_password

# ----------------------------------------------------------------------------
# 4. Optional External Email / Notification Gateway (SMTP / SendGrid)
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_api_key
SMTP_SENDER="Kivora Notifications <notifications@kivora.org>"
