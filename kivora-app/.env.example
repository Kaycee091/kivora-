# ============================================================================
# KIVORA MONOREPO ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================================
# Copy this file to .env.local for Next.js web admin, and use the variables
# below for local development, edge functions, and mobile builds.
# NEVER commit files containing real keys or secrets to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Web Admin Client-Side Variables (Next.js public variables)
# ----------------------------------------------------------------------------
# The root URL of your Supabase project (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# The public anonymous client API key (safe for browser & mobile apps; enforces RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----------------------------------------------------------------------------
# 2. Mobile App (Flutter) Environment Variables
# ----------------------------------------------------------------------------
# Pass these into your flutter run/build command via --dart-define:
# flutter run -d chrome --dart-define=SUPABASE_URL=https://your-project-id.supabase.co --dart-define=SUPABASE_ANON_KEY=your-anon-key
# (Alternatively, SUPABASE_PUBLISHABLE_KEY is also accepted as an alias for SUPABASE_ANON_KEY)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----------------------------------------------------------------------------
# 3. Server-Side & Supabase CLI Variables
# ----------------------------------------------------------------------------
# Elevated service role secret (Bypasses RLS - ONLY for server/admin scripts & Edge Functions)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database direct connection password for migrations and local CLI linking
SUPABASE_DB_PASSWORD=your_secure_db_password

# ----------------------------------------------------------------------------
# 4. Email Delivery via Brevo SMTP (web/admin server: .env.local or hosting env)
# ----------------------------------------------------------------------------
# Supabase does NOT send any email. The web/admin server generates verification
# codes and sends them through Brevo. See docs/email-brevo-setup.md.
# Brevo dashboard -> SMTP & API -> SMTP tab:
#   BREVO_SMTP_USER = the "Login" (e.g. 8a1b2c001@smtp-brevo.com), NOT your account email
#   BREVO_SMTP_KEY  = a generated SMTP key (xsmtpsib-...), NOT an API key (xkeysib-...)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_login@smtp-brevo.com
BREVO_SMTP_KEY=xsmtpsib-your_brevo_smtp_key
# Must be a sender (or on a domain) verified in Brevo -> Senders, Domains
EMAIL_FROM_ADDRESS=notifications@your-verified-domain.com
EMAIL_FROM_NAME=Kivora
# Optional: secret for hashing codes (defaults to SUPABASE_SERVICE_ROLE_KEY). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_OTP_SECRET=
# Comma-separated origins allowed to call the email API (the Flutter web app's URL)
CORS_ALLOWED_ORIGINS=http://localhost:5000

# ----------------------------------------------------------------------------
# 5. Flutter -> email API URL (pass with --dart-define)
# ----------------------------------------------------------------------------
# flutter run --dart-define=KIVORA_API_URL=https://your-admin-domain.com
KIVORA_API_URL=http://localhost:3000
